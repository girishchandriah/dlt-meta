[
    {
        "data_flow_id": "100",
        "data_flow_group": "A1",
        "source_system": "MYSQL",
        "source_format": "cloudFiles",
        "source_details": {
            "source_database": "APP",
            "source_table": "CUSTOMERS",
            "source_path_dev": "tests/resources/data/customers",
            "source_schema_path": "tests/resources/schema/customer_schema.ddl",
            "source_metadata": {
                "include_autoloader_metadata_column": "True",
                "autoloader_metadata_col_name": "source_metadata",
                "select_metadata_cols": {
                    "input_file_name": "_metadata.file_name",
                    "input_file_path": "_metadata.file_path"
                }
            }
        },
        "landing_database_dev": "landing",
        "landing_database_staging": "landing",
        "landing_database_prd": "landing",
        "landing_table": "customers_cdc",
        "landing_reader_options": {
            "cloudFiles.format": "json",
            "cloudFiles.inferColumnTypes": "true",
            "cloudFiles.rescuedDataColumn": "_rescued_data"
        },
        "landing_table_path_dev": "tests/resources/delta/customers",
        "landing_table_properties": {
            "pipelines.autoOptimize.managed": "false",
            "pipelines.reset.allowed": "false"
        },
        "landing_sinks":[{
            "name": "landing_sink1",
            "format": "delta",
            "options": {
                "tablename": "landing.customers_cdc"
            }
        },
        {"name": "landing_sink2",
        "format": "delta",
        "options": {
            "tablename": "landing.customers_cdc"
        }
        }
        ],
        "refinery_database_dev": "refinery",
        "refinery_database_staging": "refinery",
        "refinery_database_prd": "refinery",
        "refinery_table": "customers",
        "refinery_cdc_apply_changes": {
            "keys": [
                "id"
            ],
            "sequence_by": "operation_date",
            "scd_type": "1",
            "apply_as_deletes": "operation = 'DELETE'",
            "except_column_list": [
                "operation",
                "operation_date",
                "_rescued_data"
            ]
        },
        "refinery_table_path_dev": "tests/resources/data/refinery/customers",
        "refinery_table_properties": {
            "pipelines.autoOptimize.managed": "false",
            "pipelines.reset.allowed": "false",
            "pipelines.autoOptimize.zOrderCols": "id,email"
        },
        "refinery_transformation_json_dev": "tests/resources/refinery_transformations.json",
        "refinery_data_quality_expectations_json_dev": "tests/resources/dqe/customers/refinery_data_quality_expectations.json",
        "refinery_sinks":[{
            "name": "refinery_sink",
            "format": "delta",
            "options": {
                "tablename": "refinery.customers_cdc"
            }
        } ,
        {
            "name": "refinery_customer_sink",
            "format": "kafka",
            "options": {
                "kafka_sink_servers_secret_scope_name":"kafka_sink_servers_secret_scope_name",
                "kafka_sink_servers_secret_scope_key":"kafka_sink_servers_secret_scope_key",
                "kafka.security.protocol":"PLAINTEXT",
                "startingOffsets":"earliest",
                "checkpointLocation":"{dbfs_path}/integration_tests/kafka_test_checkpoint/",
                "topic":"{kafka_sink_topic}"
            },
            "select_exp":["value","topic","timestamp"],
            "where_clause":["value is not null"]                       
        }           
    ]

    }
]
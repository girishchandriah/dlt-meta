[
    {
        "data_flow_id": "007",
        "data_flow_group": "my_people",

        "source_system": "Manual_Download",
        "source_format": "cloudFiles",

        "source_details": {
            "source_path_dev": "{uc_volume_path}/demo/dabs/resources/data/people",
            "source_path_prod": "{uc_volume_path}/demo/dabs/resources/data/people",
            "source_metadata": {
                "include_autoloader_metadata_column": "True",
                "autoloader_metadata_col_name": "source_metadata",
                "select_metadata_cols": {
                    "input_file_name": "_metadata.file_name",
                    "input_file_path": "_metadata.file_path"
                }
            }         
        },
        "landing_catalog_dev": "{uc_catalog_name}",
        "landing_database_dev": "{landing_schema}",
        "landing_catalog_prod": "{uc_catalog_name}",
        "landing_database_prod": "{landing_schema}",        
        "landing_table": "people_landing",
        "landing_quarantine_table": "people_landing_quarantine",
        "landing_cluster_by": ["country"],

        "landing_table_properties" : {
            "pipelines.autoOptimize.managed": "true", 
            "pipelines.reset.allowed": "true",
            "delta.autoOptimize.optimizeWrite": "true",
            "delta.autoOptimize.autoCompact": "true",
            "delta.tuneFileSizesForRewrites": "true",
            "delta.columnMapping.mode": "name",
            "delta.checkpointRetentionDuration": "30 days",
            "delta.deletedFileRetentionDuration": "30 days",
            "delta.logRetentionDuration": "30 days"
        },

        "landing_reader_options": {
            "cloudFiles.format": "csv",
            "cloudFiles.inferColumnTypes": "true",
            "cloudFiles.rescuedDataColumn": "_rescued_data"
        },
        "refinery_catalog_dev": "{uc_catalog_name}",
        "refinery_database_dev": "{refinery_schema}",
        "refinery_catalog_prod": "{uc_catalog_name}",
        "refinery_database_prod": "{refinery_schema}",
        "refinery_table": "people_refinery",
        "refinery_cluster_by": ["country"],

        "refinery_table_properties" : {
            "pipelines.autoOptimize.managed": "true", 
            "pipelines.reset.allowed": "true",
            "delta.autoOptimize.optimizeWrite": "true",
            "delta.autoOptimize.autoCompact": "true",
            "delta.tuneFileSizesForRewrites": "true",
            "delta.columnMapping.mode": "name",
            "delta.checkpointRetentionDuration": "30 days",
            "delta.deletedFileRetentionDuration": "30 days",
            "delta.logRetentionDuration": "30 days"
        },

        "refinery_transformation_json_dev": "{uc_volume_path}/demo/dabs/conf/refinery_queries_people.json",
        "refinery_data_quality_expectations_json_dev": "{uc_volume_path}/demo/dabs/conf/dqe/dqe_refinery_people.json",

        "refinery_transformation_json_prod": "{uc_volume_path}/demo/dabs/conf/refinery_queries_people.json",
        "refinery_data_quality_expectations_json_prod": "{uc_volume_path}/demo/dabs/conf/dqe/dqe_refinery_people.json",

        "refinery_cdc_apply_changes": {
            "keys": [
                "id"
            ],
            "sequence_by": "id",
            "scd_type": "1"
        }
    }
    
